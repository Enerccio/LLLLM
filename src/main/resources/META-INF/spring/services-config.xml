<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean class="io.github.enerccio.llllm.model.service.impl.UserServiceImpl">
        <property name="entityManager" ref="em"/>
        <property name="singleUser" value="${single.mode:true}"/>
        <property name="singleUserName" value="${single.mode.user:root}"/>
    </bean>

    <bean class="io.github.enerccio.llllm.model.service.impl.AIServiceImpl">
        <property name="entityManager" ref="em"/>
    </bean>

    <bean class="io.github.enerccio.llllm.model.service.impl.OpenAICompatibleServiceImpl">
        <property name="entityManager" ref="em"/>
    </bean>

    <bean class="io.github.enerccio.llllm.model.service.impl.ChatCompletionServiceImpl">
        <property name="entityManager" ref="em"/>
    </bean>

</beans>